# One of these must be set, depending on MASSTIMINGS_MODEL.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional — pick the model. Any LiteLLM model id works.
# Examples:
#   openai/gpt-4o-mini
#   openai/gpt-4o
#   anthropic/claude-sonnet-4-5
#   gemini/gemini-1.5-flash
MASSTIMINGS_MODEL=openai/gpt-4o-mini
