---
import Layout from "../components/Layout.astro";
---

<Layout
  title="Today's Readings — MK Mass Times"
  description="Daily Mass readings for the Diocese of Northampton, from Universalis."
  favicon="%F0%9F%93%96"
>
  <div class="flex items-center gap-2 my-1 mb-3.5 flex-wrap">
    <a href="/" class="inline-flex items-center gap-1 text-ink-2 no-underline text-[0.88rem] font-medium py-1.5 px-2.5 pl-1.5 rounded-lg hover:bg-surface hover:text-ink">
      ← Mass times
    </a>
    <div class="font-controls ml-auto inline-flex bg-surface border border-rule rounded-full p-0.5" role="group" aria-label="Text size">
      <button class="border-0 bg-transparent text-ink-2 py-1 px-2.5 rounded-full cursor-pointer font-semibold text-[0.78rem] aria-pressed:bg-accent aria-pressed:text-on-accent" data-size="0.92rem" aria-pressed="false" title="Smaller">A</button>
      <button class="border-0 bg-transparent text-ink-2 py-1 px-2.5 rounded-full cursor-pointer font-semibold text-[0.95rem] aria-pressed:bg-accent aria-pressed:text-on-accent" data-size="1.05rem" aria-pressed="true" title="Default">A</button>
      <button class="border-0 bg-transparent text-ink-2 py-1 px-2.5 rounded-full cursor-pointer font-semibold text-[1.15rem] aria-pressed:bg-accent aria-pressed:text-on-accent" data-size="1.25rem" aria-pressed="false" title="Larger">A</button>
    </div>
  </div>

  <header class="m-0 mb-4">
    <h1 class="text-[1.45rem] font-bold tracking-tight leading-tight m-0 mb-1">Today's Readings</h1>
    <div id="dateLine" class="text-accent font-semibold text-[1rem]">Loading…</div>
    <div id="dayLine" class="day-line text-ink-3 text-[0.88rem] mt-0.5"></div>
  </header>

  <main id="main">
    <div id="loadingMsg" class="text-center py-8 text-ink-3 text-[0.95rem]">
      Loading today's readings from Universalis…
    </div>
  </main>

  <footer id="attribution" class="mt-6 mb-2 pt-3 border-t border-rule text-[0.78rem] text-ink-3 leading-relaxed"></footer>

  <script>
    import "../scripts/universalis.ts";
  </script>
</Layout>
